{
  "name": "coffeehunter-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CoffeeHunter iOS/Android 横屏应用",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "build:web": "npm run prepare:web && vite build web --outDir ../dist --emptyOutDir",
    "sync": "npm run build:web && cap sync",
    "sync:ios": "npm run build:web && cap sync ios",
    "sync:android": "npm run build:web && cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "test:web": "npm run build:web && node --test tests/*.test.mjs",
    "verify": "npm run test:web"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "vite": "7.1.3"
  }
}
